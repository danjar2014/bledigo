// BlediGo - Prisma Schema
// Database: SQLite (dev local) - voir schema.postgres.prisma pour la prod
// Generated: 2026-08-05

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ==================== ENUMS ====================

// ==================== MODELS ====================

model User {
  id                String     @id @default(uuid())
  email             String     @unique
  passwordHash      String     @map("password_hash")
  firstName         String     @map("first_name")
  lastName          String     @map("last_name")
  phone             String?    @unique
  avatarUrl         String?    @map("avatar_url")
  role              String
  /// Roles supplementaires : un proprietaire peut aussi voyager.
  secondaryRoles    String  @default("[]") @map("secondary_roles")
  status            String @default("active")
  emailVerified     Boolean    @default(false) @map("email_verified")
  phoneVerified     Boolean    @default(false) @map("phone_verified")
  identityVerified  Boolean    @default(false) @map("identity_verified")
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")
  deletedAt         DateTime?  @map("deleted_at")
  identityDocument String? @map("identity_document")

  // Relations
  travelerPassport  TravelerPassport?
  ownerPassport     OwnerPassport?
  listings          Listing[]       @relation("OwnerListings")
  agencyListings    Listing[]       @relation("AgencyListings")
  bookingsAsTraveler Booking[]      @relation("TravelerBookings")
  bookingsAsOwner   Booking[]       @relation("OwnerBookings")
  reviewsAsReviewer Review[]        @relation("ReviewerReviews")
  reviewsAsReviewee Review[]        @relation("RevieweeReviews")
  messages          Message[]
  conversations     Conversation[]
  reverseSearches   ReverseSearch[]
  reverseOffers     ReverseOffer[]
  subscriptions     Subscription[]
  sanctionsApplied  Sanction[]      @relation("SanctionAppliedBy")
  sanctionsReceived Sanction[]      @relation("SanctionUser")
  controlVisits     ControlVisit[]  @relation("AgentVisits")
  auditLogs         AuditLog[]
  contactAttempts     ContactAttempt[]
  reverseSearchCredit ReverseSearchCredit?
  unlocks             ReverseSearchUnlock[] @relation("OwnerUnlocks")

  @@index([email])
  @@index([role])
  @@index([status])
  @@map("users")
}

model TravelerPassport {
  id                  String   @id @default(uuid())
  userId              String   @unique @map("user_id")
  trustScore          Int      @default(50) @map("trust_score")
  totalStays          Int      @default(0) @map("total_stays")
  totalNights         Int      @default(0) @map("total_nights")
  cancellationRate    Float  @default(0) @map("cancellation_rate")
  recommendationCount Int      @default(0) @map("recommendation_count")
  incidentCount       Int      @default(0) @map("incident_count")
  disputeCount        Int      @default(0) @map("dispute_count")
  badges              String     @default("[]")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")
  noShowCount Int @default(0) @map("no_show_count")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("traveler_passports")
}

model OwnerPassport {
  id                String   @id @default(uuid())
  userId            String   @unique @map("user_id")
  trustScore        Int      @default(50) @map("trust_score")
  totalListings     Int      @default(0) @map("total_listings")
  totalBookings     Int      @default(0) @map("total_bookings")
  totalRevenue      Float  @default(0) @map("total_revenue")
  responseRate      Float  @default(0) @map("response_rate")
  acceptanceRate    Float  @default(0) @map("acceptance_rate")
  incidentCount     Int      @default(0) @map("incident_count")
  disputeCount      Int      @default(0) @map("dispute_count")
  badges            String     @default("[]")
  subscriptionTier  String   @default("free") @map("subscription_tier")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  avgResponseTime     Int @default(0) @map("avg_response_time")
  offPlatformAttempts Int @default(0) @map("off_platform_attempts")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("owner_passports")
}

model Listing {
  id                    String            @id @default(uuid())
  ownerId               String            @map("owner_id")
  agencyId              String?           @map("agency_id")
  title                 String
  description           String
  slug                  String            @unique
  address               String
  city                  String
  region                String
  country               String            @default("Tunisia")
  postalCode            String?           @map("postal_code")
  latitude              Float
  longitude             Float
  propertyType          String      @map("property_type")
  maxGuests             Int               @map("max_guests")
  bedrooms              Int
  bathrooms             Int
  pricePerNight         Float           @map("price_per_night")
  cleaningFee           Float           @default(0) @map("cleaning_fee")
  serviceFee            Float           @default(0) @map("service_fee")
  currency              String          @default("TND")
  status                String     @default("draft")
  trustScore            Int               @default(50) @map("trust_score")
  qualityScore          Int               @default(0) @map("quality_score")
  cleanlinessScore      Int               @default(0) @map("cleanliness_score")
  complianceScore       Int               @default(0) @map("compliance_score")
  safetyScore           Int               @default(0) @map("safety_score")
  certificationLevel    String @default("none") @map("certification_level")
  certificationExpiresAt DateTime?        @map("certification_expires_at")
  totalBookings         Int               @default(0) @map("total_bookings")
  totalReviews          Int               @default(0) @map("total_reviews")
  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @updatedAt @map("updated_at")
  deletedAt             DateTime?         @map("deleted_at")
  surfaceM2             Int?              @map("surface_m2")
  floors                Int?              @default(1)
  yearBuilt             Int?              @map("year_built")
  securityDeposit       Float             @default(0) @map("security_deposit")
  locationScore         Int               @default(0) @map("location_score")
  valueScore            Int               @default(0) @map("value_score")
  avgRating             Float             @default(0) @map("avg_rating")
  isEditable            Boolean           @default(true) @map("is_editable")
  lastModifiedAt        DateTime?         @map("last_modified_at")
  modificationCount     Int               @default(0) @map("modification_count")
  rules                 String            @default("{}")
  amenities             String            @default("[]")
  houseRules            String            @default("[]") @map("house_rules")
  checkInTime           String            @default("15:00") @map("check_in_time")
  checkOutTime          String            @default("11:00") @map("check_out_time")
  minNights             Int               @default(1) @map("min_nights")
  maxNights             Int?              @map("max_nights")
  instantBook           Boolean           @default(false) @map("instant_book")

  // Relations
  owner           User              @relation("OwnerListings", fields: [ownerId], references: [id])
  agency          User?             @relation("AgencyListings", fields: [agencyId], references: [id])
  photos          ListingPhoto[]
  passport        ListingPassport?
  bookings        Booking[]
  reviews         Review[]
  certifications  Certification[]
  controlVisits   ControlVisit[]
  reverseOffers   ReverseOffer[]
  conversations   Conversation[]
  modificationHistory ListingModification[]
  calendar        ListingCalendar[]

  @@index([ownerId])
  @@index([status])
  @@index([certificationLevel])
  @@index([latitude, longitude])
  @@index([city])
  @@map("listings")
}

model ListingPhoto {
  id                String    @id @default(uuid())
  listingId         String    @map("listing_id")
  url               String
  thumbnailUrl      String?   @map("thumbnail_url")
  isPrimary         Boolean   @default(false) @map("is_primary")
  isCertified       Boolean   @default(false) @map("is_certified")
  certificationDate DateTime? @map("certification_date")
  metadata          String      @default("{}")
  createdAt         DateTime  @default(now()) @map("created_at")

  // Relations
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
  @@map("listing_photos")
}

model ListingPassport {
  id                    String   @id @default(uuid())
  listingId             String   @unique @map("listing_id")
  stayCount             Int      @default(0) @map("stay_count")
  guestCount            Int      @default(0) @map("guest_count")
  ageDays               Int      @default(0) @map("age_days")
  certificationsHistory String     @default("[]") @map("certifications_history")
  certifiedPhotosCount  Int      @default(0) @map("certified_photos_count")
  videosCount           Int      @default(0) @map("videos_count")
  controlVisitsCount    Int      @default(0) @map("control_visits_count")
  incidents             String     @default("[]")
  disputes              String     @default("[]")
  disputeResolutions    String     @default("[]") @map("dispute_resolutions")
  scoresHistory         String     @default("[]") @map("scores_history")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  // Relations
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@map("listing_passports")
}

model Booking {
  id                String           @id @default(uuid())
  listingId         String           @map("listing_id")
  travelerId        String           @map("traveler_id")
  ownerId           String           @map("owner_id")
  checkIn           DateTime         @map("check_in")
  checkOut          DateTime         @map("check_out")
  guestsCount       Int              @map("guests_count")
  totalNights       Int              @map("total_nights")
  basePrice         Float          @map("base_price")
  cleaningFee       Float          @map("cleaning_fee")
  serviceFee        Float          @map("service_fee")
  insuranceFee      Float          @default(0) @map("insurance_fee")
  totalPrice        Float          @map("total_price")
  currency          String
  status            String    @default("pending")
  paymentStatus     String    @default("pending") @map("payment_status")
  validationStatus  String @default("pending") @map("validation_status")
  validationDeadline DateTime?       @map("validation_deadline")
  disputeId         String?          @map("dispute_id")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")
  securityDeposit Float   @default(0) @map("security_deposit")
  validationData  String? @map("validation_data")

  // Relations
  listing   Listing    @relation(fields: [listingId], references: [id])
  traveler  User       @relation("TravelerBookings", fields: [travelerId], references: [id])
  owner     User       @relation("OwnerBookings", fields: [ownerId], references: [id])
  payment   Payment?
  disputeRecord Dispute?
  review    Review?
  conversation Conversation?
  inventoryCheck InventoryCheck?

  @@index([listingId])
  @@index([travelerId])
  @@index([status])
  @@index([checkIn, checkOut])
  @@map("bookings")
}

model Payment {
  id                    String        @id @default(uuid())
  bookingId             String        @unique @map("booking_id")
  stripePaymentIntentId String        @map("stripe_payment_intent_id")
  amount                Float
  currency              String
  status                String @default("pending")
  heldAt                DateTime?     @map("held_at")
  capturedAt            DateTime?     @map("captured_at")
  refundedAt            DateTime?     @map("refunded_at")
  refundAmount          Float?      @map("refund_amount")
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")
  refundReason String? @map("refund_reason")

  // Relations
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model Dispute {
  id              String       @id @default(uuid())
  bookingId       String       @unique @map("booking_id")
  initiatedBy     String       @map("initiated_by")
  type            String
  status          String @default("pending")
  description     String
  resolutionNotes String?      @map("resolution_notes")
  decidedBy       String?      @map("decided_by")
  decidedAt       DateTime?    @map("decided_at")
  refundAmount    Float?     @map("refund_amount")
  sanctions       String         @default("[]")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  // Relations
  booking   Booking          @relation(fields: [bookingId], references: [id])
  evidence  DisputeEvidence[]

  @@index([status])
  @@map("disputes")
}

model DisputeEvidence {
  id          String       @id @default(uuid())
  disputeId   String       @map("dispute_id")
  uploadedBy  String       @map("uploaded_by")
  type        String
  url         String
  description String?
  createdAt   DateTime     @default(now()) @map("created_at")

  // Relations
  dispute Dispute @relation(fields: [disputeId], references: [id], onDelete: Cascade)

  @@index([disputeId])
  @@map("dispute_evidence")
}

model Review {
  id          String    @id @default(uuid())
  bookingId   String    @unique @map("booking_id")
  listingId   String    @map("listing_id")
  reviewerId  String    @map("reviewer_id")
  revieweeId  String    @map("reviewee_id")
  type        String
  rating      Int
  cleanliness Int
  accuracy    Int
  checkIn     Int       @map("check_in")
  communication Int
  location    Int
  value       Int
  comment     String
  isVerified  Boolean   @default(false) @map("is_verified")
  isFlagged   Boolean   @default(false) @map("is_flagged")
  flagReason  String?   @map("flag_reason")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  aiScore      Float? @map("ai_score")
  helpfulCount Int    @default(0) @map("helpful_count")

  // Relations
  booking  Booking  @relation(fields: [bookingId], references: [id])
  listing  Listing  @relation(fields: [listingId], references: [id])
  reviewer User     @relation("ReviewerReviews", fields: [reviewerId], references: [id])
  reviewee User     @relation("RevieweeReviews", fields: [revieweeId], references: [id])

  @@index([listingId])
  @@index([reviewerId])
  @@index([revieweeId])
  @@map("reviews")
}

model Conversation {
  id            String    @id @default(uuid())
  bookingId     String?   @unique @map("booking_id")
  participantIds String @map("participant_ids") @default("[]")
  listingId     String?   @map("listing_id")
  isBlocked     Boolean   @default(false) @map("is_blocked")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  blockReason String? @map("block_reason")

  // Relations
  booking  Booking?  @relation(fields: [bookingId], references: [id])
  listing  Listing?  @relation(fields: [listingId], references: [id])
  messages Message[]
  users    User[]

  @@index([listingId])
  @@map("conversations")
}

model Message {
  id              String      @id @default(uuid())
  conversationId  String      @map("conversation_id")
  senderId        String      @map("sender_id")
  type            String @default("text")
  content         String
  metadata        String        @default("{}")
  isFlagged       Boolean     @default(false) @map("is_flagged")
  flagReason      String?     @map("flag_reason")
  createdAt       DateTime    @default(now()) @map("created_at")
  aiAnalysis String? @map("ai_analysis")

  // Relations
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User        @relation(fields: [senderId], references: [id])

  @@index([conversationId])
  @@index([senderId])
  @@map("messages")
}

model Certification {
  id          String             @id @default(uuid())
  listingId   String             @map("listing_id")
  level       String
  status      String             @default("pending")
  requestedAt DateTime           @default(now()) @map("requested_at")
  validatedAt DateTime?          @map("validated_at")
  expiresAt   DateTime?          @map("expires_at")
  validatedBy String?            @map("validated_by")
  report      String               @default("{}")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")
  scoreBreakdown String @default("{}") @map("score_breakdown")

  // Relations
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
  @@map("certifications")
}

model ControlVisit {
  id            String    @id @default(uuid())
  listingId     String    @map("listing_id")
  agentId       String    @map("agent_id")
  scheduledAt   DateTime  @map("scheduled_at")
  completedAt   DateTime? @map("completed_at")
  status        String    @default("scheduled")
  checklist     String      @default("{}")
  photos        String      @default("[]")
  notes         String?
  gpsCoordinates String?  @map("gps_coordinates")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  videos            String  @default("[]")
  weatherConditions String? @map("weather_conditions")

  // Relations
  listing Listing @relation(fields: [listingId], references: [id])
  agent   User    @relation("AgentVisits", fields: [agentId], references: [id])

  @@index([listingId])
  @@index([agentId])
  @@map("control_visits")
}

model Sanction {
  id           String       @id @default(uuid())
  userId       String       @map("user_id")
  type         String
  reason       String
  evidence     String         @default("{}")
  durationDays Int?         @map("duration_days")
  expiresAt    DateTime?    @map("expires_at")
  appliedBy    String       @map("applied_by")
  appliedAt    DateTime     @default(now()) @map("applied_at")
  revokedBy    String?      @map("revoked_by")
  revokedAt    DateTime?    @map("revoked_at")
  createdAt    DateTime     @default(now()) @map("created_at")

  // Relations
  user      User @relation("SanctionUser", fields: [userId], references: [id])
  appliedByUser User @relation("SanctionAppliedBy", fields: [appliedBy], references: [id])

  @@index([userId])
  @@index([type])
  @@map("sanctions")
}

model ReverseSearch {
  id           String              @id @default(uuid())
  travelerId   String              @map("traveler_id")
  title        String
  description  String
  destination  String
  checkIn      DateTime            @map("check_in")
  checkOut     DateTime            @map("check_out")
  guestsCount  Int                 @map("guests_count")
  bedrooms     Int?
  budgetMin    Float?            @map("budget_min")
  budgetMax    Float?            @map("budget_max")
  requirements String                @default("{}")
  status       String @default("active")
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")
  city              String?
  region            String?
  bathrooms         Int?
  amenitiesRequired String    @default("[]") @map("amenities_required")
  propertyTypes     String    @default("[]") @map("property_types")
  certificationMin  String?   @map("certification_min")
  minTrustScore     Int?      @map("min_trust_score")
  viewCount         Int       @default(0) @map("view_count")
  offerCount        Int       @default(0) @map("offer_count")
  expiresAt         DateTime? @map("expires_at")

  // Relations
  traveler User          @relation(fields: [travelerId], references: [id])
  offers   ReverseOffer[]
  unlocks       ReverseSearchUnlock[]

  @@index([travelerId])
  @@index([status])
  @@map("reverse_searches")
}

model ReverseOffer {
  id              String            @id @default(uuid())
  reverseSearchId String            @map("reverse_search_id")
  listingId       String            @map("listing_id")
  ownerId         String            @map("owner_id")
  proposedPrice   Float           @map("proposed_price")
  message         String?
  status          String @default("pending")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  originalPrice   Float?    @map("original_price")
  discountPercent Float?    @map("discount_percent")
  isViewed        Boolean   @default(false) @map("is_viewed")
  viewedAt        DateTime? @map("viewed_at")
  expiresAt       DateTime? @map("expires_at")
  /// Montant propose par le voyageur en reponse a l offre
  counterPrice     Float?    @map("counter_price")
  counterAt        DateTime? @map("counter_at")
  /// Nombre d allers-retours, pour borner la negociation
  negotiationRound Int       @default(0) @map("negotiation_round")

  // Relations
  reverseSearch ReverseSearch @relation(fields: [reverseSearchId], references: [id])
  listing       Listing       @relation(fields: [listingId], references: [id])
  owner         User          @relation(fields: [ownerId], references: [id])

  @@index([reverseSearchId])
  @@index([listingId])
  @@map("reverse_offers")
}

model Subscription {
  id                   String             @id @default(uuid())
  userId               String             @map("user_id")
  type                 String
  status               String @default("active")
  price                Float
  currency             String
  interval             String
  stripeSubscriptionId String             @map("stripe_subscription_id")
  currentPeriodStart   DateTime           @map("current_period_start")
  currentPeriodEnd     DateTime           @map("current_period_end")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")
  features String @default("[]")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("subscriptions")
}

model InsurancePolicy {
  id             String           @id @default(uuid())
  bookingId      String           @map("booking_id")
  type           String
  provider       String @default("internal")
  premiumAmount  Float          @map("premium_amount")
  coverageAmount Float          @map("coverage_amount")
  status         String  @default("active")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  claimReason    String? @map("claim_reason")
  claimDocuments String  @default("[]") @map("claim_documents")

  @@index([bookingId])
  @@map("insurance_policies")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?  @map("user_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  details    String     @default("{}")
  ipAddress  String   @map("ip_address")
  userAgent  String   @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  // Relations
  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model ContactAttempt {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  type        String
  content     String
  context     String
  detectedBy  String   @default("ai") @map("detected_by")
  confidence  Float    @default(0)
  messageId   String?  @map("message_id")
  isBlocked   Boolean  @default(false) @map("is_blocked")
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([type])
  @@map("contact_attempts")
}

model InventoryCheck {
  id              String    @id @default(uuid())
  bookingId       String    @unique @map("booking_id")
  checkInPhotos   String    @default("[]") @map("check_in_photos")
  checkOutPhotos  String    @default("[]") @map("check_out_photos")
  checkInNotes    String?   @map("check_in_notes")
  checkOutNotes   String?   @map("check_out_notes")
  damagesFound    String    @default("[]") @map("damages_found")
  depositStatus   String    @default("pending") @map("deposit_status")
  depositReturned Float?    @map("deposit_returned")
  depositKept     Float?    @map("deposit_kept")
  status          String    @default("pending")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  // Relations
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("inventory_checks")
}

model ListingModification {
  id          String   @id @default(uuid())
  listingId   String   @map("listing_id")
  modifiedBy  String   @map("modified_by")
  fieldName   String   @map("field_name")
  oldValue    String?  @map("old_value")
  newValue    String   @map("new_value")
  reason      String?
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
  @@map("listing_modifications")
}

model ReverseSearchCredit {
  id               String    @id @default(uuid())
  userId           String    @unique @map("user_id")
  creditsTotal     Int       @default(0) @map("credits_total")
  creditsUsed      Int       @default(0) @map("credits_used")
  creditsRemaining Int       @default(0) @map("credits_remaining")
  lastPurchasedAt  DateTime? @map("last_purchased_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("reverse_search_credits")
}

model ReverseSearchUnlock {
  id              String   @id @default(uuid())
  ownerId         String   @map("owner_id")
  reverseSearchId String   @map("reverse_search_id")
  creditsSpent    Int      @default(1) @map("credits_spent")
  createdAt       DateTime @default(now()) @map("created_at")

  // Relations
  owner         User          @relation("OwnerUnlocks", fields: [ownerId], references: [id], onDelete: Cascade)
  reverseSearch ReverseSearch @relation(fields: [reverseSearchId], references: [id], onDelete: Cascade)

  @@unique([ownerId, reverseSearchId])
  @@index([ownerId])
  @@map("reverse_search_unlocks")
}

/// Une periode du calendrier d un logement.
///
/// Trois usages dans une seule table, parce qu ils portent tous sur un
/// intervalle de dates : fermer des dates, y appliquer un tarif particulier,
/// ou y imposer une duree minimale. Une periode peut combiner les trois.
///
/// Les bornes suivent la convention des sejours : `startDate` incluse,
/// `endDate` exclue. Une fermeture du 10 au 12 rend indisponibles les nuits du
/// 10 et du 11, et laisse le 12 reservable en arrivee.
model ListingCalendar {
  id            String   @id @default(uuid())
  listingId     String   @map("listing_id")
  startDate     DateTime @map("start_date")
  endDate       DateTime @map("end_date")
  /// Dates fermees a la reservation.
  blocked       Boolean  @default(false)
  /// Tarif substitue au prix de base sur la periode.
  pricePerNight Float?   @map("price_per_night")
  /// Duree minimale imposee sur la periode.
  minNights     Int?     @map("min_nights")
  /// Note privee de l hote : travaux, usage personnel, haute saison.
  note          String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
  @@index([listingId, startDate, endDate])
  @@map("listing_calendar")
}
