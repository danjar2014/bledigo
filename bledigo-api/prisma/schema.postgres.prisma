/// Une periode du calendrier d un logement.
///
/// Trois usages dans une seule table, parce qu ils portent tous sur un
/// intervalle de dates : fermer des dates, y appliquer un tarif particulier,
/// ou y imposer une duree minimale. Une periode peut combiner les trois.
///
/// Les bornes suivent la convention des sejours : `startDate` incluse,
/// `endDate` exclue. Une fermeture du 10 au 12 rend indisponibles les nuits du
/// 10 et du 11, et laisse le 12 reservable en arrivee.
model ListingCalendar {
  id            String   @id @default(uuid())
  listingId     String   @map("listing_id")
  startDate     DateTime @map("start_date")
  endDate       DateTime @map("end_date")
  /// Dates fermees a la reservation.
  blocked       Boolean  @default(false)
  /// Tarif substitue au prix de base sur la periode.
  pricePerNight Float?   @map("price_per_night")
  /// Duree minimale imposee sur la periode.
  minNights     Int?     @map("min_nights")
  /// Note privee de l hote : travaux, usage personnel, haute saison.
  note          String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
  @@index([listingId, startDate, endDate])
  @@map("listing_calendar")
}

// ---------------------------------------------------------------------------
// Prestataires de services
//
// Deux metiers derriere un meme socle : le menage et l entretien, proposes aux
// hotes ; la location de voiture, proposee au voyageur une fois son sejour
// reserve. Ils partagent le compte, la verification, la zone servie et la
// notation — rien d autre.
//
// Phase d amorcage : ANNUAIRE. Aucun montant ne transite, exactement comme pour
// le sejour, et les coordonnees ne s echangent qu apres acceptation. La
// prestation est neanmoins modelisee comme une reservation, pour que le
// paiement s allume plus tard sans reconstruction.
// ---------------------------------------------------------------------------

model ServiceProvider {
  id            String    @id @default(uuid())
  /// Compte de connexion. En phase 1 il est cree par l administration, apres
  /// constatation du statut d agence : `provider` n est pas auto-attribuable.
  userId        String    @unique @map("user_id")
  /// menage | location_voiture
  type          String
  /// Nom affiche. Pour une personne physique, c est son nom et prenom : le
  /// champ garde son intitule plutot que d en ajouter un second qui dirait la
  /// meme chose.
  companyName   String    @map("company_name")
  /// societe | individuel. Une personne physique ne peut proposer que du
  /// menage : la location de vehicules suppose une entreprise. Ce n est donc
  /// pas le statut d entreprise qu on constate pour elle, mais son identite.
  legalForm     String    @default("societe") @map("legal_form")
  /// pending tant que l administration n a pas constate le statut.
  status        String    @default("pending")
  verifiedAt    DateTime? @map("verified_at")
  verifiedBy    String?   @map("verified_by")
  /// Matricule fiscal ou registre de commerce, constate a la main en phase 1.
  registrationNumber String? @map("registration_number")
  city          String?
  region        String?
  latitude      Float?
  longitude     Float?
  /// Rayon d intervention. La proximite se calcule en Haversine, comme la
  /// recherche de logements : pas de dependance geospatiale supplementaire.
  serviceRadiusKm Int     @default(30) @map("service_radius_km")
  phone         String?
  description   String?
  /// Meme trio que les annonces : la confiance se lit pareil des deux cotes.
  trustScore    Float     @default(0) @map("trust_score")
  avgRating     Float     @default(0) @map("avg_rating")
  totalReviews  Int       @default(0) @map("total_reviews")
  totalJobs     Int       @default(0) @map("total_jobs")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  user     User             @relation("ProviderAccount", fields: [userId], references: [id])
  vehicles Vehicle[]
  services ServiceBooking[]
  reviews  ServiceReview[]

  @@index([type, status])
  @@index([city])
  @@index([latitude, longitude])
  @@map("service_providers")
}

model Vehicle {
  id             String   @id @default(uuid())
  providerId     String   @map("provider_id")
  brand          String
  model          String
  year           Int?
  /// Immatriculation, sans contrainte d unicite : c est une donnee saisie, pas
  /// un identifiant. Le @unique de `phone` a deja coute assez cher.
  plate          String?
  /// citadine | berline | suv | utilitaire | luxe
  category       String   @default("citadine")
  transmission   String   @default("manuelle")
  fuel           String   @default("essence")
  seats          Int      @default(5)
  airConditioned Boolean  @default(true) @map("air_conditioned")
  pricePerDay    Float    @map("price_per_day")
  deposit        Float    @default(0)
  /// OBSOLETE depuis VehiclePhoto. Conservee parce qu elle porte des valeurs :
  /// meme traitement que control_visits_count. Lire `photos` a la place.
  photoUrl       String?  @map("photo_url")

  /// --- Conditions de location, servies AVANT la demande ---
  ///
  /// Elles suivent la meme regle que les conditions d annulation d un sejour :
  /// une condition decouverte au comptoir n est pas une condition, c est une
  /// mauvaise surprise, et elle est inopposable.
  ///
  /// Kilometrage inclus par jour. `null` = illimite, ce que pratiquent la
  /// plupart des agences : le defaut ne doit pas etre 0, qui signifierait
  /// « aucun kilometre autorise ».
  kmPerDay          Int?     @map("km_per_day")
  /// Prix du kilometre au-dela du forfait. Annoncer un forfait sans lui ne dit
  /// rien : le locataire ignore ce que coute le depassement.
  extraKmPrice      Float?   @map("extra_km_price")
  minDriverAge      Int      @default(21) @map("min_driver_age")
  minLicenceYears   Int      @default(2)  @map("min_licence_years")
  /// plein_a_plein | plein_a_vide | identique
  fuelPolicy        String   @default("plein_a_plein") @map("fuel_policy")
  /// Options facturees en sus, en JSON : [{ code, label, pricePerDay }].
  /// Un JSON plutot que des colonnes : la liste varie d une agence a l autre,
  /// et chaque nouvelle option couterait sinon une migration.
  options           String?
  pickupLocation    String?  @map("pickup_location")
  /// Restitution ailleurs qu au depart. `null` = meme lieu que la prise.
  returnLocation    String?  @map("return_location")
  deliveryAvailable Boolean  @default(false) @map("delivery_available")
  deliveryFee       Float    @default(0) @map("delivery_fee")

  /// active | maintenance | retire
  status         String   @default("active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  provider ServiceProvider  @relation(fields: [providerId], references: [id], onDelete: Cascade)
  calendar VehicleCalendar[]
  services ServiceBooking[]
  photos   VehiclePhoto[]

  @@index([providerId])
  @@index([status])
  @@map("vehicles")
}

/// Galerie d un vehicule. Meme forme que ListingPhoto : on ne loue pas une
/// voiture qu on ne voit pas, et une seule photo ne montre ni l interieur ni
/// l etat de la carrosserie.
model VehiclePhoto {
  id        String   @id @default(uuid())
  vehicleId String   @map("vehicle_id")
  url       String
  isPrimary Boolean  @default(false) @map("is_primary")
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@map("vehicle_photos")
}

/// Sinistre constate au retour du vehicule.
///
/// Il est CONSIGNE, jamais sanctionnant par lui-meme. Le projet a deja refuse
/// qu une sanction repose sur la parole d une seule partie — c est tout le sens
/// du double signal a l arrivee d un sejour. Une agence qui declare seule ne
/// peut donc pas fermer un compte : elle inscrit un fait, que le client peut
/// contredire, et l administration tranche a la main.
model VehicleIncident {
  id               String   @id @default(uuid())
  serviceBookingId String   @map("service_booking_id")
  vehicleId        String?  @map("vehicle_id")
  /// Compte de l agence declarante, trace pour que ses declarations soient
  /// comptables contre elle si elle en abuse.
  declaredBy       String   @map("declared_by")
  declaredAt       DateTime @default(now()) @map("declared_at")
  /// rayure | choc | mecanique | retard | carburant | proprete | autre
  type             String
  description      String
  estimatedCost    Float?   @map("estimated_cost")
  /// URLs des photos du dommage, en JSON. La preuve vaut mieux que l assertion.
  photos           String?
  contestedAt      DateTime? @map("contested_at")
  contestReason    String?   @map("contest_reason")
  /// etabli | conteste | abandonne. `etabli` par defaut : sans contestation, la
  /// declaration tient. Contester ne l efface pas, elle l oppose.
  resolution       String    @default("etabli")
  resolvedAt       DateTime? @map("resolved_at")
  resolvedBy       String?   @map("resolved_by")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  serviceBooking ServiceBooking @relation(fields: [serviceBookingId], references: [id], onDelete: Cascade)

  @@index([serviceBookingId])
  @@index([resolution])
  @@map("vehicle_incidents")
}

/// Meme forme que ListingCalendar, deliberement : l agence ferme des dates et
/// substitue un tarif de la meme facon qu un hote. Bornes : debut incluse, fin
/// exclue.
model VehicleCalendar {
  id          String   @id @default(uuid())
  vehicleId   String   @map("vehicle_id")
  startDate   DateTime @map("start_date")
  endDate     DateTime @map("end_date")
  blocked     Boolean  @default(false)
  pricePerDay Float?   @map("price_per_day")
  note        String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@index([vehicleId, startDate, endDate])
  @@map("vehicle_calendar")
}

model ServiceBooking {
  id          String   @id @default(uuid())
  providerId  String   @map("provider_id")
  /// menage | location_voiture
  type        String
  /// Le sejour auquel la prestation se rattache. Renseigne pour une location de
  /// voiture, qui n est proposee qu apres reservation du logement.
  bookingId   String?  @map("booking_id")
  /// Le logement concerne, pour une prestation de menage.
  listingId   String?  @map("listing_id")
  vehicleId   String?  @map("vehicle_id")
  /// Voyageur ou hote selon le metier.
  requesterId String   @map("requester_id")
  /// Debut et fin PORTENT L HEURE, pas seulement le jour : un menage se
  /// convient sur un creneau. Pas de colonnes startTime/endTime separees, qui
  /// diraient la meme chose une seconde fois et pourraient la contredire.
  startDate   DateTime @map("start_date")
  endDate     DateTime @map("end_date")
  /// Montant retenu. Reste a 0 tant que rien n est convenu ; l acceptation y
  /// recopie le tarif retenu et le fige.
  price       Float
  currency    String   @default("TND")

  /// --- Ou intervenir, pour une prestation de menage ---
  ///
  /// Le prestataire decidait auparavant sans savoir ou. La ville et le
  /// gouvernorat se pre-remplissent depuis le logement via common/localities,
  /// le quartier se saisit — aucun referentiel supplementaire a construire.
  city        String?
  /// Gouvernorat, meme unite administrative que Listing.region.
  region      String?
  /// Quartier ou zone, la maille que connaissent les prestataires.
  district    String?
  /// Precision d acces : etage, code, point de rendez-vous. Pas l adresse
  /// exacte, qui ne se livre qu apres acceptation comme le reste.
  addressHint String?  @map("address_hint")

  /// --- Tarif et negociation ---
  ///
  /// Meme vocabulaire que ReverseOffer, deliberement : il n y a aucune raison
  /// qu une negociation de menage s apprenne differemment d une negociation de
  /// sejour.
  proposedPrice    Float?    @map("proposed_price")
  counterPrice     Float?    @map("counter_price")
  counterAt        DateTime? @map("counter_at")
  /// Borne les allers-retours. Sans elle une demande reste ouverte indefiniment.
  negotiationRound Int       @default(0) @map("negotiation_round")
  /// pending | confirmed | cancelled | completed
  status      String   @default("pending")
  /// Les coordonnees ne s echangent qu apres acceptation, comme pour le sejour.
  contactSharedAt DateTime? @map("contact_shared_at")
  cancelledAt DateTime? @map("cancelled_at")
  cancelledBy String?   @map("cancelled_by")
  note        String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  provider  ServiceProvider @relation(fields: [providerId], references: [id])
  vehicle   Vehicle?        @relation(fields: [vehicleId], references: [id])
  requester User            @relation("ServiceRequests", fields: [requesterId], references: [id])
  reviews   ServiceReview[]
  incidents VehicleIncident[]

  @@index([providerId])
  @@index([requesterId])
  @@index([bookingId])
  @@index([status])
  @@map("service_bookings")
}

/// Notation MUTUELLE : le prestataire note aussi son client. Un hote qui laisse
/// un logement dans un etat impraticable doit etre visible, sans quoi seuls les
/// prestataires portent le risque de la relation.
model ServiceReview {
  id               String   @id @default(uuid())
  serviceBookingId String   @map("service_booking_id")
  providerId       String   @map("provider_id")
  authorId         String   @map("author_id")
  /// client_vers_prestataire | prestataire_vers_client
  direction        String
  rating           Int
  comment          String?
  createdAt        DateTime @default(now()) @map("created_at")

  serviceBooking ServiceBooking  @relation(fields: [serviceBookingId], references: [id], onDelete: Cascade)
  provider       ServiceProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  /// Un avis par sens et par prestation. Un @unique sur la seule prestation
  /// interdisait le second avis : la notation n aurait ete mutuelle que sur le
  /// papier, et seul le premier a ecrire aurait eu la parole.
  @@unique([serviceBookingId, direction])
  @@index([providerId])
  @@index([authorId])
  @@map("service_reviews")
}
