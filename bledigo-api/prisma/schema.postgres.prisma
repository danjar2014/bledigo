  creditsTotal     Int       @default(0) @map("credits_total")
  creditsUsed      Int       @default(0) @map("credits_used")
  creditsRemaining Int       @default(0) @map("credits_remaining")
  lastPurchasedAt  DateTime? @map("last_purchased_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("reverse_search_credits")
