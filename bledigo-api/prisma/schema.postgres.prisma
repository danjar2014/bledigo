  checkInPhotos   String    @default("[]") @map("check_in_photos")
  checkOutPhotos  String    @default("[]") @map("check_out_photos")
  checkInNotes    String?   @map("check_in_notes")
  checkOutNotes   String?   @map("check_out_notes")
  damagesFound    String    @default("[]") @map("damages_found")
  depositStatus   String    @default("pending") @map("deposit_status")
  depositReturned Float?    @map("deposit_returned")
  depositKept     Float?    @map("deposit_kept")
  status          String    @default("pending")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  // Relations
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("inventory_checks")
