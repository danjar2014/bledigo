model ReverseSearchUnlock {
  id              String   @id @default(uuid())
  ownerId         String   @map("owner_id")
  reverseSearchId String   @map("reverse_search_id")
  creditsSpent    Int      @default(1) @map("credits_spent")
  createdAt       DateTime @default(now()) @map("created_at")

  // Relations
  owner         User          @relation("OwnerUnlocks", fields: [ownerId], references: [id], onDelete: Cascade)
